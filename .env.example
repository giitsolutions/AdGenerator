# --- AI Generation (Google Gemini free tier) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Product Photo Search (Unsplash free tier) — ACTIVE (tried first) ---
# Free key: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# --- Product Photo Search (Pexels free tier) — ACTIVE (tried second) ---
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# --- Product Photo Generation (Hugging Face free tier) — ALTERNATE ---
# Not currently used (see services/imageService.js comments) — free-tier
# image models were unreliable (frequent 410 deprecation errors).
# Free token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here

# --- Auto Image Generation & Hosting ---
# Free imgbb API key: https://api.imgbb.com/ (sign up, no cost)
# Used to host the auto-generated ad graphic so Instagram can fetch it.
IMGBB_API_KEY=your_imgbb_api_key_here

# --- Server ---
PORT=5000

# --- Authentication ---
# Any long random string — used to sign login sessions. Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# --- Instagram Posting via Make.com (ACTIVE for now) ---
# Make.com scenario webhook URL (Webhooks module -> Instagram for Business module)
# Make.com handles the Instagram OAuth connection for you.
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id_here

# --- Direct Instagram OAuth (built, NOT currently used) ---
# A working alternative to Make.com above lives in
# controllers/instagramAuthController.js — a "Connect Instagram"
# button with no third-party tool involved. Not wired in right now;
# fill these in and re-enable it later if wanted.
#   1. Create an app at https://developers.facebook.com/apps (type: Business)
#   2. Add the "Instagram Graph API" product
#   3. In App Settings > Basic, copy the App ID and App Secret below
#   4. In Facebook Login settings, add this exact Valid OAuth Redirect URI:
#      http://localhost:5000/api/instagram/callback
#FACEBOOK_APP_ID=your_facebook_app_id_here
#FACEBOOK_APP_SECRET=your_facebook_app_secret_here
#FACEBOOK_REDIRECT_URI=http://localhost:5000/api/instagram/callback

# --- Scheduler ---
# Cron format: every 6 hours = "0 */6 * * *"  |  every day at 9am = "0 9 * * *"
POST_INTERVAL_CRON=0 */6 * * *

# Set to false to pause ALL automatic post generation while testing —
# prevents unwanted drafts piling up from campaigns you're just experimenting with.
SCHEDULER_ENABLED=true

# --- Daily Theme Queue + Email Approval ---
# How often the daily themed job checks for the next queued theme to
# use. Default: 9am every day.
THEME_CRON=0 9 * * *

# Free Gmail SMTP — sends the daily approval emails. Use YOUR OWN
# Gmail account (not each user's), with an "App Password" (NOT your
# normal Gmail password): https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification enabled on the Gmail account first.)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password

# Used to build the Approve/Reject links inside approval emails.
# Change to your real domain once deployed (must be reachable by
# whoever clicks the email link).
APP_BASE_URL=http://localhost:5000
